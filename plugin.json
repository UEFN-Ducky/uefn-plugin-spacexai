{
  "id": "spacexai",
  "kind": "plugin",
  "version": "1.0.7",
  "label": "SpaceXAI",
  "description": "SpaceXAI (Grok) API for Settings → LLMs. Install from Store → Gateways, then enable to show SpaceXAI under Providers & Keys.",
  "min_app_version": "1.0.523",
  "default_enabled": true,
  "secret_keys": [
    "spacexai"
  ],
  "contributes": {
    "llm.providers": [
      {
        "id": "spacexai",
        "label": "SpaceXAI",
        "kind": "secret",
        "secret_key": "spacexai",
        "order": 42
      }
    ],
    "walkthrough": {
      "id": "spacexai",
      "title": "Set up SpaceXAI",
      "auto_start": "first_enable",
      "settings_tab": "LLMs",
      "steps": [
        {
          "target": "settings.llms.provider.spacexai",
          "title": "Open SpaceXAI",
          "body": "Press the SpaceXAI row in this table. The page slides open so you can paste your API key.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.key",
          "title": "API key",
          "body": "Paste your API key from console.x.ai.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.save",
          "title": "Test & Save",
          "body": "Press Test & Save after you paste a key.",
          "advance": "require_click",
          "mode": "rect"
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
